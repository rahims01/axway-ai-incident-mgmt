# ─── App ───────────────────────────────────────────────────────────
APP_DEBUG=false

# ─── Azure OpenAI ──────────────────────────────────────────────────
# Leave blank to run in mock-LLM mode (no real API calls)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_GPT4O=gpt-4o
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ─── Axway SecureTransport ─────────────────────────────────────────
# Leave MOCK_AXWAY=true to use built-in realistic demo data
MOCK_AXWAY=true
AXWAY_ADMIN_URL=https://axway-host:444
AXWAY_ADMIN_USER=admin
AXWAY_ADMIN_PASSWORD=

# ─── Database ──────────────────────────────────────────────────────
# SQLite (default — zero config). Swap to PostgreSQL URL when ready.
DATABASE_URL=sqlite:///./axway_aiops.db

# ─── Notifications (all optional — logs to console when blank) ─────
SLACK_BOT_TOKEN=
SLACK_ALERT_CHANNEL=#mft-alerts
SLACK_APPROVAL_CHANNEL=#mft-ops
TEAMS_WEBHOOK_URL=

# ─── ServiceNow (optional) ─────────────────────────────────────────
SERVICENOW_URL=
SERVICENOW_USER=
SERVICENOW_PASSWORD=

# ─── Thresholds ────────────────────────────────────────────────────
CERT_EXPIRY_WARN_DAYS=30
FAILURE_RATE_THRESHOLD=3
QUEUE_DEPTH_WARN=500
JVM_HEAP_WARN_PCT=85
DISK_WARN_PCT=80
AUTO_FIX_CONFIDENCE_THRESHOLD=85
