# Local development — safe to use as-is (all mock, no real credentials)
APP_DEBUG=true

# Leave blank → mock LLM mode (no Azure OpenAI calls)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_GPT4O=gpt-4o
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Mock Axway — uses built-in demo data
MOCK_AXWAY=true
AXWAY_ADMIN_URL=https://axway-host:444
AXWAY_ADMIN_USER=admin
AXWAY_ADMIN_PASSWORD=

DATABASE_URL=sqlite:///./data/axway_aiops.db

SLACK_BOT_TOKEN=
SLACK_ALERT_CHANNEL=#mft-alerts
SLACK_APPROVAL_CHANNEL=#mft-ops
TEAMS_WEBHOOK_URL=

SERVICENOW_URL=
SERVICENOW_USER=
SERVICENOW_PASSWORD=

CERT_EXPIRY_WARN_DAYS=30
FAILURE_RATE_THRESHOLD=3
QUEUE_DEPTH_WARN=500
JVM_HEAP_WARN_PCT=85
DISK_WARN_PCT=80
AUTO_FIX_CONFIDENCE_THRESHOLD=85
